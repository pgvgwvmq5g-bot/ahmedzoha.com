---

<BaseLayout title="About Me" description="Learn more about Dr Ahmed Zoha - Senior Lecturer (Associate Professor) in Distributed AI, Research Director, Driving AI for Social Good">
  
  <!-- Hero & Biography Section -->
  <section class="pt-12 lg:pt-20 pb-16 lg:pb-24">
    <div class="grid lg:grid-cols-[1fr,auto] gap-10 lg:gap-16 items-center">
      <!-- Left Content -->
      <div class="animate-fade-in order-2 lg:order-1">
        <!-- Name & Title -->
        <h1 class="text-4xl lg:text-5xl font-bold mb-2">
          Dr Ahmed Zoha
      </h1>
        <p class="text-2xl lg:text-3xl text-accent-yellow font-light mb-2">
          Senior Lecturer (Associate Professor) in Distributed AI
        </p>
        <p class="text-sm lg:text-base text-text-muted font-medium tracking-wide mb-8">
          SMIEEE · FRSA · FRET
        </p>
        
        <!-- Biography Paragraphs -->
        <div class="space-y-5 text-text-secondary leading-relaxed max-w-xl">
          <p>
            I believe AI should do more than think—it should care. As a technology leader, 
            educator, and advocate for responsible innovation, I have dedicated my career to 
            building intelligent systems that advance <span class="text-accent-yellow font-medium">AI for social good</span>.
          </p>
          <p>
            Recognized among <span class="text-text-primary font-medium">Stanford's Top 2% Most Cited Scientists</span> 
            and endorsed as a <span class="text-text-primary font-medium">UK Exceptional Talent</span> by the Royal Academy 
            of Engineering, I lead research at the intersection of Federated Learning, Edge Intelligence, and
            AI-Driven Systems. With <span class="text-accent-yellow">5,450 citations</span>,
            <span class="text-accent-yellow">£2.2M in competitive external funding</span>,
            <span class="text-accent-yellow">132 publications</span>, and
            <span class="text-accent-yellow">11 PhD completions</span>, my work bridges theoretical breakthroughs 
            with transformative applications—from award-winning NHS-deployed systems for dementia care 
            to privacy-preserving technologies for smart cities.
          </p>
          <p>
            As Director of <span class="text-accent-yellow font-medium">FLAIR</span>, 
            I lead a group of dynamic researchers in developing distributed AI that protects privacy 
            while unlocking collaborative intelligence. My vision is a world-leading programme that 
            translates cutting-edge research into real-world impact across healthcare, infrastructure, and beyond.
          </p>
          <p>
            I am equally passionate about education and mentorship—shaping the next generation of AI 
            researchers and practitioners who will carry this mission forward. For me, the true measure 
            of research is not publications alone, but <span class="text-accent-yellow">lives improved and problems solved</span>.
          </p>
        </div>
      </div>
      
      <!-- Profile Photo (Right) -->
      <div class="flex-shrink-0 animate-fade-in-delay order-1 lg:order-2 mx-auto lg:mx-0">
        <div class="w-48 h-56 lg:w-56 lg:h-64 rounded-2xl overflow-hidden bg-gradient-to-br from-accent-yellow/20 to-accent-yellow/5 p-1">
          <div class="w-full h-full rounded-xl overflow-hidden">
            <img 
              src="/images/profile-large.jpg" 
              alt="Dr Ahmed Zoha"
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center bg-dark-700 text-accent-yellow text-5xl font-bold\'>AZ</div>'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Impact -->
  <section class="py-16 lg:py-24 border-t border-dark-500/30">
    <div class="flex items-center justify-between mb-10">
      <h2 class="text-2xl lg:text-3xl font-medium scroll-animate">Research Impact & Recognition</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {researchImpact.map((card, index) => (
        <div class="impact-card bg-dark-700 rounded-2xl p-6 border border-dark-500/30 
                    hover:border-accent-yellow/50 transition-all duration-300 scroll-animate"
             style={`animation-delay: ${index * 0.1}s`}>
          <div class="w-12 h-12 bg-accent-yellow/10 rounded-xl flex items-center justify-center mb-4">
            {card.icon === 'globe' && (
              <svg class="w-6 h-6 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {card.icon === 'impact' && (
              <svg class="w-6 h-6 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            {card.icon === 'award' && (
              <svg class="w-6 h-6 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            )}
          </div>
          <h3 class="text-lg font-medium mb-4">{card.title}</h3>
          <ul class="space-y-2">
            {card.items.map((item) => (
              <li class="text-sm text-text-secondary flex items-start gap-2">
                <span class="text-accent-yellow mt-1">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center scroll-animate">
      <a href="/research/" class="inline-flex items-center gap-2 text-accent-yellow hover:underline">
        Explore My Research
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Leadership Quote -->
  <section class="py-8">
    <div class="bg-dark-700 rounded-2xl p-6 lg:p-8 border border-dark-500/30 max-w-2xl mx-auto scroll-animate">
      <div class="text-center">
        <div class="text-4xl text-accent-yellow/20 font-serif mb-2">"</div>
        <blockquote class="text-base lg:text-lg italic text-text-secondary leading-relaxed mb-4">
          Impactful research requires more than technical excellence—it demands strategic vision, 
          collaborative leadership, and a relentless focus on solving problems that matter.
        </blockquote>
        <cite class="text-accent-yellow font-medium not-italic text-sm">— Dr Ahmed Zoha</cite>
      </div>
    </div>
  </section>

  <!-- Major Funded Programmes Led/Contributed -->
  <section class="py-16 lg:py-24 border-t border-dark-500/30">
    <h2 class="text-2xl lg:text-3xl font-medium mb-3 scroll-animate">Major Funded Programmes Led/Contributed</h2>
    <p class="text-text-secondary text-sm mb-10 max-w-3xl scroll-animate">
      £2.2M in competitive external funding: £433,446 as Principal Investigator (including EPSRC MIMER and the Innovate UK KTP with AWTG) and £1.76M as Co-Investigator (Scotland 5G Centre and DCMS 5G New Thinking), plus two SFC Global Challenges awards as Co-Investigator.
    </p>
    <div class="grid md:grid-cols-2 gap-4">
      {fundedProgrammes.map((project, index) => (
        <div class="funding-card bg-dark-700 rounded-xl p-5 border border-dark-500/30 
                    hover:border-accent-yellow/50 transition-all duration-300 scroll-animate"
             style={`animation-delay: ${index * 0.1}s`}>
          <h3 class="font-medium mb-3 text-base lg:text-lg">{project.name}</h3>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-2 py-0.5 bg-accent-yellow/10 text-accent-yellow text-xs rounded">
              {project.role}
            </span>
            {project.funder && (
              <span class="px-2 py-0.5 bg-teal-500/10 text-teal-400 text-xs rounded">
                {project.funder}
              </span>
            )}
          </div>
          <p class="text-sm text-text-secondary mb-3 leading-relaxed">{project.description}</p>
          <div class="flex justify-between items-center text-sm pt-2 border-t border-dark-500/30">
            <span class="text-accent-yellow font-medium">{project.funding}</span>
            <span class="text-text-muted">{project.period}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Appointments & Service Roles - Multi-column Multi-row -->
  <section class="py-16 lg:py-24 border-t border-dark-500/30">
    <h2 class="text-2xl lg:text-3xl font-medium mb-10 scroll-animate">Appointments & Service Roles</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Academic Appointments -->
      <div class="bg-dark-700 rounded-xl p-5 border border-dark-500/30 hover:border-accent-yellow/30 transition-all scroll-animate">
        <h3 class="text-lg font-medium mb-4 text-accent-yellow">Academic Appointments</h3>
        <div class="space-y-0">
          {academicAppointments.map((item, index) => (
            <div class="relative pl-5 pb-4 border-l-2 border-dark-500">
              <div class="absolute -left-[5px] top-0 w-2 h-2 bg-accent-yellow rounded-full"></div>
              <span class="text-xs text-accent-yellow font-medium">{item.period}</span>
              <h4 class="text-sm font-medium mt-1">{item.role}</h4>
              <p class="text-xs text-text-secondary">{item.institution}</p>
              {item.summary && <p class="text-xs text-text-muted mt-1 leading-relaxed">{item.summary}</p>}
            </div>
          ))}
        </div>
      </div>

      <!-- Research Appointments -->
      <div class="bg-dark-700 rounded-xl p-5 border border-dark-500/30 hover:border-accent-yellow/30 transition-all scroll-animate" style="animation-delay: 0.05s">
        <h3 class="text-lg font-medium mb-4 text-accent-yellow">Research Appointments</h3>
        <div class="space-y-0">
          {researchAppointments.map((item, index) => (
            <div class="relative pl-5 pb-4 border-l-2 border-dark-500">
              <div class="absolute -left-[5px] top-0 w-2 h-2 bg-accent-yellow rounded-full"></div>
              <span class="text-xs text-accent-yellow font-medium">{item.period}</span>
              <h4 class="text-sm font-medium mt-1">{item.role}</h4>
              <p class="text-xs text-text-secondary">{item.institution}</p>
              {item.summary && <p class="text-xs text-text-muted mt-1 leading-relaxed">{item.summary}</p>}
            </div>
          ))}
        </div>
      </div>

      <!-- Editorial Leadership -->
      <div class="bg-dark-700 rounded-xl p-5 border border-dark-500/30 hover:border-accent-yellow/30 transition-all scroll-animate" style="animation-delay: 0.1s">
        <h3 class="text-lg font-medium mb-4 text-accent-yellow">Editorial Leadership</h3>
        <ul class="space-y-3">
          {advisoryRoles[0].items.map((item) => (
            <li class="text-xs">
              <span class="font-medium text-text-primary">{item.role}</span>
              <span class="text-text-secondary"> — {item.desc}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Conference Leadership -->
      <div class="bg-dark-700 rounded-xl p-5 border border-dark-500/30 hover:border-accent-yellow/30 transition-all scroll-animate" style="animation-delay: 0.15s">
        <h3 class="text-lg font-medium mb-4 text-accent-yellow">Conference Leadership</h3>
        <ul class="space-y-3">
          {advisoryRoles[1].items.map((item) => (
            <li class="text-xs">
              <span class="font-medium text-text-primary">{item.role}</span>
              <span class="text-text-secondary"> — {item.desc}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- External Examining & Grant Review -->
      <div class="bg-dark-700 rounded-xl p-5 border border-dark-500/30 hover:border-accent-yellow/30 transition-all scroll-animate" style="animation-delay: 0.2s">
        <h3 class="text-lg font-medium mb-4 text-accent-yellow">Examining & Grant Review</h3>
        <ul class="space-y-3">
          {advisoryRoles[2].items.map((item) => (
            <li class="text-xs">
              <span class="font-medium text-text-primary">{item.role}</span>
              <span class="text-text-secondary"> — {item.desc}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Professional Advisory Roles -->
      <div class="bg-dark-700 rounded-xl p-5 border border-dark-500/30 hover:border-accent-yellow/30 transition-all scroll-animate" style="animation-delay: 0.25s">
        <h3 class="text-lg font-medium mb-4 text-accent-yellow">Professional Advisory</h3>
        <ul class="space-y-3">
          {advisoryRoles[3].items.map((item) => (
            <li class="text-xs">
              <span class="font-medium text-text-primary">{item.role}</span>
              <span class="text-text-secondary"> — {item.desc}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <!-- Education -->
  <section class="py-16 lg:py-24 border-t border-dark-500/30">
    <h2 class="text-2xl lg:text-3xl font-medium mb-10 scroll-animate">Education</h2>
    <div class="relative">
      <!-- Timeline line -->
      <div class="hidden md:block absolute top-6 left-0 right-0 h-0.5 bg-dark-500"></div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {education.map((edu, index) => (
          <div class="relative scroll-animate" style={`animation-delay: ${index * 0.1}s`}>
