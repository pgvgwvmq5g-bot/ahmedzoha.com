            <!-- Content card -->
            <div class="md:pt-12">
              <div class="bg-dark-700 rounded-xl p-6 border border-dark-500/30 
                          hover:border-accent-yellow/50 transition-all duration-300 text-center">
                <span class="text-sm text-accent-yellow font-medium">{edu.year}</span>
                <div class="text-2xl font-bold text-text-primary mt-2 mb-1">{edu.degree}</div>
                <h3 class="font-medium text-sm mb-2">{edu.field}</h3>
                <p class="text-xs text-text-secondary">{edu.institution}</p>
